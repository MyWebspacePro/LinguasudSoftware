# Public base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection (required)
DATABASE_URL=postgres://linguasud:linguasud@localhost:5432/linguasud

# Initial office account, created only when no office account exists yet
BOOTSTRAP_ADMIN_EMAIL=admin@linguasud.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-production

# Optional mail delivery (the app runs without it; in-app and push still work)
# MAIL_PROVIDER=resend
# MAIL_API_KEY=
# MAIL_FROM=sprachkurse@linguasud.com
# MAIL_SMTP_URL=smtp://user:pass@host:587
